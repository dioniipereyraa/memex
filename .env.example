# Copiar a .env y ajustar valores. .env está en .gitignore.

# Backend de embeddings. Default: fastembed (zero-config, modelo embebido
# en ONNX que se baja la primera vez). Alternativa: ollama (requiere tener
# Ollama corriendo local).
MEMEX_EMBED_BACKEND=fastembed

# Nombre del modelo. Si no se setea, cada backend usa su default:
# - fastembed: nomic-ai/nomic-embed-text-v1.5-Q (~130 MB cuantizado)
# - ollama: nomic-embed-text
# MEMEX_EMBED_MODEL=nomic-ai/nomic-embed-text-v1.5

# Solo se usa si MEMEX_EMBED_BACKEND=ollama
OLLAMA_HOST=http://localhost:11434

# Path a la base SQLite (default: ./data/memex.db)
MEMEX_DB_PATH=./data/memex.db

# Path al directorio donde guardás los exports oficiales de Claude.ai
MEMEX_EXPORTS_DIR=./data/exports

# Tamaño de chunk en tokens aprox (default: 500)
MEMEX_CHUNK_SIZE=500

# Overlap entre chunks en tokens (default: 50)
MEMEX_CHUNK_OVERLAP=50

# Nivel de log: DEBUG, INFO, WARNING, ERROR
MEMEX_LOG_LEVEL=INFO

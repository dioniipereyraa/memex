# Copy to .env and adjust values. .env is in .gitignore.

# Embeddings backend. Default: fastembed (zero-config, ONNX model embedded,
# downloads itself the first time). Alternative: ollama (requires a local
# Ollama instance running).
MEMEX_EMBED_BACKEND=fastembed

# Model name. If unset, each backend uses its default:
# - fastembed: nomic-ai/nomic-embed-text-v1.5-Q (~130 MB quantized)
# - ollama: nomic-embed-text
# MEMEX_EMBED_MODEL=nomic-ai/nomic-embed-text-v1.5

# fastembed resource caps (keep a background ingest from hogging the machine).
# onnxruntime otherwise uses a thread per core and grows a memory arena that
# scales with batch_size * sequence_length. At the default 500-token chunk
# size, measured peak RSS is ~1.0 GB at batch=2, ~1.6 GB at batch=4 (default),
# ~2.4 GB at batch=8. Lower the batch size if RAM is tight; raise it (and the
# threads) for a faster one-off bulk ingest on an idle machine.
# MEMEX_EMBED_THREADS=2
# MEMEX_EMBED_BATCH_SIZE=4

# Only used if MEMEX_EMBED_BACKEND=ollama
OLLAMA_HOST=http://localhost:11434

# SQLite database path (default: ./data/memex.db)
MEMEX_DB_PATH=./data/memex.db

# Directory where you keep official Claude.ai exports
MEMEX_EXPORTS_DIR=./data/exports

# Approximate chunk size in tokens (default: 500)
MEMEX_CHUNK_SIZE=500

# Overlap between chunks in tokens (default: 50)
MEMEX_CHUNK_OVERLAP=50

# Remote MCP server (memex serve-remote): lets claude.ai consume Memex as a
# custom connector. All four values are required; the server refuses to start
# with incomplete config. See README, section "Connecting from claude.ai".
#
# Public HTTPS URL where the tunnel exposes this machine (e.g. Tailscale
# Funnel). OAuth redirects are derived from it; the GitHub OAuth App callback
# must be <MEMEX_REMOTE_BASE_URL>/auth/callback.
# MEMEX_REMOTE_BASE_URL=https://my-mac.my-tailnet.ts.net
#
# Local port the server binds to on loopback (the tunnel proxies to it).
# MEMEX_REMOTE_PORT=8377
#
# GitHub OAuth App credentials (create one at
# https://github.com/settings/developers > OAuth Apps).
# MEMEX_GITHUB_CLIENT_ID=Iv1.xxxxxxxxxxxx
# MEMEX_GITHUB_CLIENT_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
#
# GitHub identities allowed to access your chats (comma-separated). Any other
# account that completes the OAuth flow is rejected on every request. Each
# entry matches the username OR the immutable numeric account id (find yours
# at https://api.github.com/users/<name>). The numeric id is the safer choice
# because usernames can be renamed or reused after an account is deleted; the
# username form is accepted too for convenience.
# MEMEX_REMOTE_ALLOWED_GITHUB_LOGINS=your-github-username

# Log level: DEBUG, INFO, WARNING, ERROR
MEMEX_LOG_LEVEL=INFO

# On-demand auto-summaries with Claude Haiku (opt-in). Requires the extra
# `summaries`: `uv sync --extra summaries`. When ON, summaries are generated
# lazily by `search_chats` for top-3 results without a cached summary, in
# parallel. Off by default to avoid surprise API calls.
MEMEX_SUMMARY_ENABLED=false

# Anthropic model for summary generation. Default: Haiku (cheap, fast).
# MEMEX_SUMMARY_MODEL=claude-haiku-4-5-20251001

# Max tokens for the generated summary. Default 200 (~3 sentences).
# MEMEX_SUMMARY_MAX_TOKENS=200

# Anthropic API key. If MEMEX_SUMMARY_ENABLED=true and this is missing or
# invalid, the search returns the matching chats without a summary and logs
# a warning per chat. The search itself never aborts.
# ANTHROPIC_API_KEY=sk-ant-...

{
  "manifest_version": 3,
  "name": "Memex Live Capture",
  "version": "0.1.0",
  "description": "Capture your claude.ai chats live and ingest them into the local Memex server. Requires `memex serve` running on 127.0.0.1.",
  "permissions": ["storage"],
  "host_permissions": [
    "https://claude.ai/*",
    "http://127.0.0.1:5777/*",
    "http://localhost:5777/*"
  ],
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "background": {
    "service_worker": "src/background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://claude.ai/*"],
      "js": ["src/inject.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://claude.ai/*"],
      "js": ["src/content.js"],
      "run_at": "document_start",
      "world": "ISOLATED"
    }
  ],
  "action": {
    "default_popup": "src/popup.html",
    "default_title": "Memex Live Capture",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; connect-src 'self' http://127.0.0.1:5777 http://localhost:5777"
  }
}
